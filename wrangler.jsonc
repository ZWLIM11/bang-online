{
  "name": "bang-online",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-10",
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "SaloonRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SaloonRoom"] }]
}
